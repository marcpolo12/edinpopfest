<local:NewsFeedViewBase
    x:Name="FeedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EdinPopFest.NewsFeedPage"
    xmlns:local="clr-namespace:EdinPopFest"
    x:DataType="local:NewsFeedViewModel"
    Title="EIPC News Feed">
  <ContentPage.Resources>

    <!-- Gig Template -->
    <DataTemplate x:Key="GigTemplate" x:DataType="local:FeedItem">
      <Border Margin="10" Padding="10">
        <Border.BackgroundColor>
          <AppThemeBinding Light="#EAF0FF" Dark="#10104D" />
        </Border.BackgroundColor>
        <VerticalStackLayout>
          <Image Aspect="AspectFit" x:Name="GigImage">
            <Image.Source>
              <UriImageSource
                  Uri="{Binding ImageUrl}"
                  CachingEnabled="True"
                  CacheValidity="7.00:00:00"/>
            </Image.Source>
          </Image>

          <VerticalStackLayout Margin="0" Padding="6,0" Spacing="0">
            <Label
                Style="{StaticResource SmallText}"
                Text="{Binding Title}"
                FontAttributes="Bold"
                LineBreakMode="WordWrap"/>
            <Label Style="{StaticResource SmallText}">
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="{Binding Venue}" />
                  <Span Text=" • " />
                  <Span Text="{Binding DisplayDate}" />
                </FormattedString>
              </Label.FormattedText>
            </Label>

            <Label
                Style="{StaticResource SmallText}"
                Text="{Binding Description}"
                LineBreakMode="WordWrap"/>

            <HorizontalStackLayout Margin="10,6,10,0" Spacing="8">
              <Button
                  Padding="10,6"
                  HorizontalOptions="Start"
                  FontFamily="FontAwesomeBrands"
                  Text="&#xF39E;"
                  FontSize="18"
                  TextColor="White"
                  BackgroundColor="#1877F2"
                  CornerRadius="18"
                  IsVisible="{Binding HasFacebookUrl}"
                  Clicked="OnFacebookClicked" />

              <Button
                  Padding="10,6"
                  HorizontalOptions="Start"
                  FontFamily="FontAwesomeBrands"
                  Text="&#xF16D;"
                  FontSize="18"
                  TextColor="White"
                  BackgroundColor="#E1306C"
                  CornerRadius="18"
                  IsVisible="{Binding HasInstagramUrl}"
                  Clicked="OnInstagramClicked" />

              <Button
                  Padding="10,6"
                  HorizontalOptions="Start"
                  Text="Tickets"
                  FontSize="18"
                  TextColor="White"
                  BackgroundColor="#2E7D32"
                  CornerRadius="18"
                  MinimumWidthRequest="96"
                  IsVisible="{Binding HasTicketsLink}"
                  Clicked="OnTicketsClicked" />
            </HorizontalStackLayout>
          </VerticalStackLayout>
        </VerticalStackLayout>

        <Border.GestureRecognizers>
          <TapGestureRecognizer
              Command="{Binding BindingContext.OpenItemCommand, Source={x:Reference Name=FeedPage}}"
              CommandParameter="{Binding .}" />
        </Border.GestureRecognizers>
      </Border>
    </DataTemplate>

    <!-- Text Post Template -->
    <DataTemplate x:Key="PostTemplate" x:DataType="local:FeedItem">
      <Border Padding="12" Margin="5,5">
        <Border.BackgroundColor>
          <AppThemeBinding Light="#EAF0FF" Dark="#10104D" />
        </Border.BackgroundColor>
        <VerticalStackLayout>
          <Label Text="{Binding Title}"
                 FontSize="18"
                 FontAttributes="Bold"/>
          <Image Source="{Binding ImageUrl}"
                 x:Name="PostImage"
                 HeightRequest="180"
                 Aspect="AspectFill" />
          <Label Text="{Binding Description}"
                 LineBreakMode="WordWrap"/>

          <HorizontalStackLayout Margin="0,8,0,0" Spacing="8">
            <Button
                Padding="10,6"
                HorizontalOptions="Start"
                FontFamily="FontAwesomeBrands"
                Text="&#xF39E;"
                FontSize="18"
                TextColor="White"
                BackgroundColor="#1877F2"
                CornerRadius="18"
                IsVisible="{Binding HasFacebookUrl}"
                Clicked="OnFacebookClicked" />

            <Button
                Padding="10,6"
                HorizontalOptions="Start"
                FontFamily="FontAwesomeBrands"
                Text="&#xF16D;"
                FontSize="18"
                TextColor="White"
                BackgroundColor="#E1306C"
                CornerRadius="18"
                IsVisible="{Binding HasInstagramUrl}"
                Clicked="OnInstagramClicked" />

            <Button
                Padding="10,6"
                HorizontalOptions="Start"
                Text="Tickets"
                FontSize="18"
                TextColor="White"
                BackgroundColor="#2E7D32"
                CornerRadius="18"
                MinimumWidthRequest="96"
                IsVisible="{Binding HasTicketsLink}"
                Clicked="OnTicketsClicked" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </Border>
    </DataTemplate>

    <local:FeedTemplateSelector x:Key="FeedSelector"
                                GigTemplate="{StaticResource GigTemplate}"
                                PostTemplate="{StaticResource PostTemplate}" />

  </ContentPage.Resources>
  <RefreshView x:Name="Refresh">
    <CollectionView
        x:Name="NewsItems"
        SelectionMode="None"
        ItemTemplate="{StaticResource FeedSelector}"
        RemainingItemsThreshold="3">
    </CollectionView>
  </RefreshView>
</local:NewsFeedViewBase>
