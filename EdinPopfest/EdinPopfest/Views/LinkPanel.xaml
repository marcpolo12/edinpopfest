<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EdinPopFest.LinkPanel">
  <Grid Margin="10,0,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
    <Grid Grid.Column="0"
          WidthRequest="14"
          HeightRequest="20"
          VerticalOptions="Start"
          Margin="0,1,0,0">
      <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
            Fill="#DB4437"
            WidthRequest="14"
            HeightRequest="20"
            Aspect="Uniform" />
      <Ellipse WidthRequest="4"
               HeightRequest="4"
               Fill="White"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,6,0,0" />
    </Grid>

    <VerticalStackLayout Grid.Column="1"
                         Padding="0"
                         Spacing="0"
                         AbsoluteLayout.LayoutBounds="0,0,1,1"
                         AbsoluteLayout.LayoutFlags="All">
      <Label x:Name="linkHeader" Style="{StaticResource LinkText}">
        <Label.GestureRecognizers>
          <TapGestureRecognizer x:Name="linkTapGesture"/>
        </Label.GestureRecognizers>
      </Label>
      <Label x:Name="linkInfo" Style="{StaticResource SmallText}"/>
    </VerticalStackLayout>
  </Grid>
</ContentView>
